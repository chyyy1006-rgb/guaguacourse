<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nextWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/nextWidgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下一节课"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nextWidgetCourse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="大学物理"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nextWidgetTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="10:30开始 · 28分钟后"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/nextWidgetRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="教西B2-306"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/nextWidgetTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="待办 · 今天 23:59 · 实验报告"
        android:textColor="@color/widget_accent"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nextWidgetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="8月9日 周日 · 第2周"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />

</LinearLayout>
